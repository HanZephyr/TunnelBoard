<WixLocalization Culture="zh-HK" Language="3076" Codepage="UTF-8" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Caption" Value="[WixBundleName] 安裝程式" /><String Id="Title" Value="[WixBundleName]" /><String Id="CheckingForUpdatesLabel" Value="正在檢查更新" /><String Id="UpdateButton" Value="更新至 [WixStdBAUpdateAvailable](&amp;U)" /><String Id="InstallHeader" Value="歡迎" /><String Id="InstallMessage" Value="安裝程式將在此電腦上安裝 [WixBundleName]。按一下「安裝」繼續，或按一下「取消」離開。" /><String Id="InstallMessageOptions" Value="安裝程式將在此電腦上安裝 [WixBundleName]。按一下「安裝」繼續，按一下「選項」設定安裝選項，或按一下「取消」離開。" /><String Id="InstallVersion" Value="版本 [WixBundleVersion]" /><String Id="ConfirmCancelMessage" Value="確定要取消嗎？" /><String Id="ExecuteUpgradeRelatedBundleMessage" Value="先前版本" /><String Id="HelpHeader" Value="安裝說明" /><String Id="HelpText" Value="/install | /repair | /uninstall | /layout [目錄] - 安裝、修復、解除安裝，或在目錄中建立完整的本機安裝副本。預設動作為安裝。&#xA;&#xA;/passive | /quiet - 顯示最少介面或完全不顯示介面，且不提示。&#xA;&#xA;/norestart - 禁止嘗試重新啟動。&#xA;/log log.txt - 將記錄寫入指定檔案。" /><String Id="HelpCloseButton" Value="關閉(&amp;C)" /><String Id="InstallLicenseLinkText" Value="[WixBundleName] 的&lt;a href=&quot;#&quot;&gt;授權條款&lt;/a&gt;。" /><String Id="InstallAcceptCheckbox" Value="我同意授權條款(&amp;A)" /><String Id="InstallOptionsButton" Value="選項(&amp;O)" /><String Id="InstallInstallButton" Value="安裝(&amp;I)" /><String Id="InstallCancelButton" Value="取消(&amp;C)" />
