<?xml version="1.0" encoding="utf-8"?>
<WixLocalization Culture="ru-RU" Language="1049" Codepage="UTF-8" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Caption" Value="Установка [WixBundleName]" /><String Id="Title" Value="[WixBundleName]" /><String Id="CheckingForUpdatesLabel" Value="Проверка обновлений" /><String Id="UpdateButton" Value="Обновить до версии [WixStdBAUpdateAvailable] (&amp;U)" /><String Id="InstallHeader" Value="Добро пожаловать" /><String Id="InstallMessage" Value="Программа установки установит [WixBundleName] на этот компьютер. Нажмите «Установить», чтобы продолжить, или «Отмена», чтобы выйти." /><String Id="InstallMessageOptions" Value="Программа установки установит [WixBundleName] на этот компьютер. Нажмите «Установить», чтобы продолжить, «Параметры», чтобы настроить установку, или «Отмена», чтобы выйти." /><String Id="InstallVersion" Value="Версия [WixBundleVersion]" /><String Id="ConfirmCancelMessage" Value="Отменить установку?" /><String Id="ExecuteUpgradeRelatedBundleMessage" Value="Предыдущая версия" /><String Id="HelpHeader" Value="Справка по установке" /><String Id="HelpText" Value="/install | /repair | /uninstall | /layout [каталог] — установить, восстановить, удалить программу или создать полную локальную копию пакета в каталоге. По умолчанию выполняется установка.&#xA;&#xA;/passive | /quiet — показать минимальный интерфейс или не показывать его вовсе.&#xA;&#xA;/norestart — запретить попытки перезапуска.&#xA;/log log.txt — записать журнал в указанный файл." /><String Id="HelpCloseButton" Value="&amp;Закрыть" /><String Id="InstallLicenseLinkText" Value="&lt;a href=&quot;#&quot;&gt;Условия лицензии&lt;/a&gt; [WixBundleName]." /><String Id="InstallAcceptCheckbox" Value="Я принимаю условия лицензии" /><String Id="InstallOptionsButton" Value="&amp;Параметры" /><String Id="InstallInstallButton" Value="&amp;Установить" /><String Id="InstallCancelButton" Value="&amp;Отмена" />
  <String Id="OptionsHeader" Value="Параметры установки" /><String Id="OptionsLocationLabel" Value="Папка установки:" /><String Id="OptionsShortcutLabel" Value="Ярлыки" /><String Id="OptionsStartMenuShortcut" Value="Добавить в меню «Пуск»" /><String Id="OptionsDesktopShortcut" Value="Создать ярлык на рабочем столе" /><String Id="OptionsPerUserScopeText" Value="Установить [WixBundleName] только для &amp;меня" /><String Id="OptionsPerMachineScopeText" Value="Установить [WixBundleName] для всех &amp;пользователей" /><String Id="OptionsBrowseButton" Value="&amp;Обзор" /><String Id="OptionsOkButton" Value="&amp;ОК" /><String Id="OptionsCancelButton" Value="&amp;Отмена" /><String Id="ProgressHeader" Value="Ход установки" /><String Id="ProgressLabel" Value="Обработка:" /><String Id="OverallProgressPackageText" Value="Инициализация..." /><String Id="ProgressCancelButton" Value="&amp;Отмена" /><String Id="ModifyHeader" Value="Изменение установки" /><String Id="ModifyRepairButton" Value="&amp;Восстановить" /><String Id="ModifyUninstallButton" Value="&amp;Удалить" /><String Id="ModifyCancelButton" Value="&amp;Отмена" />
  <String Id="SuccessHeader" Value="Установка выполнена" /><String Id="SuccessCacheHeader" Value="Кэширование завершено" /><String Id="SuccessInstallHeader" Value="Установка успешно завершена" /><String Id="SuccessLayoutHeader" Value="Размещение успешно завершено" /><String Id="SuccessModifyHeader" Value="Изменение успешно завершено" /><String Id="SuccessRepairHeader" Value="Восстановление успешно завершено" /><String Id="SuccessUninstallHeader" Value="Удаление успешно завершено" /><String Id="SuccessUnsafeUninstallHeader" Value="Удаление успешно завершено" /><String Id="SuccessLaunchCheckbox" Value="Запустить TunnelBoard после установки" /><String Id="SuccessLaunchButton" Value="&amp;Завершить и запустить" /><String Id="SuccessRestartText" Value="Перед использованием программы необходимо перезагрузить компьютер." /><String Id="SuccessUninstallRestartText" Value="Для завершения удаления необходимо перезагрузить компьютер." /><String Id="SuccessRestartButton" Value="&amp;Перезагрузить" /><String Id="SuccessCloseButton" Value="&amp;Завершить" />
  <String Id="FailureHeader" Value="Ошибка установки" /><String Id="FailureCacheHeader" Value="Ошибка кэширования" /><String Id="FailureInstallHeader" Value="Ошибка установки" /><String Id="FailureLayoutHeader" Value="Ошибка размещения" /><String Id="FailureModifyHeader" Value="Ошибка изменения" /><String Id="FailureRepairHeader" Value="Ошибка восстановления" /><String Id="FailureUninstallHeader" Value="Ошибка удаления" /><String Id="FailureUnsafeUninstallHeader" Value="Ошибка удаления" /><String Id="FailureHyperlinkLogText" Value="Установка завершилась с ошибкой. Исправьте проблему и повторите попытку. Подробности см. в &lt;a href=&quot;#&quot;&gt;файле журнала&lt;/a&gt;." /><String Id="FailureRestartText" Value="Для завершения отката необходимо перезагрузить компьютер." /><String Id="FailureRestartButton" Value="&amp;Перезагрузить" /><String Id="FailureCloseButton" Value="&amp;Закрыть" /><String Id="FilesInUseTitle" Value="Файлы используются" /><String Id="FilesInUseLabel" Value="Следующие приложения используют файлы, которые необходимо обновить:" /><String Id="FilesInUseNetfxCloseRadioButton" Value="Закрыть &amp;приложения." /><String Id="FilesInUseCloseRadioButton" Value="Закрыть &amp;приложения и попытаться перезапустить их." /><String Id="FilesInUseDontCloseRadioButton" Value="&amp;Не закрывать приложения. Потребуется перезагрузка." /><String Id="FilesInUseRetryButton" Value="&amp;Повторить" /><String Id="FilesInUseIgnoreButton" Value="&amp;Пропустить" /><String Id="FilesInUseExitButton" Value="В&amp;ыйти" />
